<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.CronPaw" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- The splash is the launcher icon blown up: icon A's paw on its own background. -->
    <style name="Theme.CronPaw.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/icon_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_paw</item>
        <item name="postSplashScreenTheme">@style/Theme.CronPaw</item>
        <item name="android:windowLightStatusBar">@bool/light_bars</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">@bool/light_bars</item>
    </style>
</resources>
